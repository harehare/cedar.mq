    ["principal == principal && 1 < 2", "true"],
    ["context.n * context.n - context.neg", "12"],
    ["if context.mfa then context.n else context.neg", "3"],
    ["if context.n > 2 then \"big\" else \"small\"", "\"big\""],
    ["[1, 2, 3].contains(2) && !([].contains(1))", "true"],
    ["{a: 1}.a", "1"],
    ["{a: 1}[\"a\"]", "1"],
