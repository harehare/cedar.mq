    ["principal.profile.geo.lat + principal.profile.geo.lon", "174"],
    ["principal.getTag(\"level\") + 1", "4"],
    ["principal.getTag(\"role\") like \"ad*\"", "true"]
  ])
  | assert_eq(failures, [])
end

def _conf_authz_failures(trials):
  let ents = _conf_entities()
  | map(filter(trials, fn(t): !_conf_authz_ok(t, ents);), fn(t): t[0];)
end

def _conf_authz_ok(t, ents):
  try:
    do
      let r = cedar_is_authorized(t[0], t[1], ents)
      | r["decision"] == t[2]["decision"] && sort(r["reasons"]) == t[2]["reasons"]
        && sort(map(r["errors"], fn(e): e["policy"];)) == t[2]["errors"]
    end
  catch(e): false
end

def test_conformance_authorization_1():
  let failures = _conf_authz_failures([
    ["permit (principal is User in Group::\"staff\", action == Action::\"edit\", resource in Album::\"trip\");\npermit (principal == User::\"alice\", action in [], resource in Album::\"trip\") unless { 1 } when { principal.age >= 18 };\nforbid (principal in Group::\"all\", action, resource is Photo in Album::\"all\");\n@id(\"p3\") forbid (principal == User::\"alice\", action == Action::\"view\", resource == Photo::\"p1\") when { context.n > 2 };", {"principal": "User::\"alice\"", "action": "Action::\"other\"", "resource": "Photo::\"p2\"", "context": {"mfa": true, "n": 1, "neg": -3, "name": "report.pdf", "empty": "", "tags": ["x"], "none": [], "nested": {"a": {"b": 1}}, "unicode": "日本語", "ip": {"__extn": {"fn": "ip", "arg": "10.0.0.5"}}, "dec": {"__extn": {"fn": "decimal", "arg": "1.5"}}, "at": {"__extn": {"fn": "datetime", "arg": "2024-10-15T11:35:00.123Z"}}, "dur": {"__extn": {"fn": "duration", "arg": "2h"}}, "who": {"__entity": {"type": "User", "id": "bob"}}}}, {"decision": "deny", "reasons": [], "errors": []}],
    ["permit (principal in Group::\"all\", action in Action::\"read\", resource is Photo in Album::\"all\") unless { principal.manager.name == \"Bob\" } when { resource has owner && resource.owner in Group::\"staff\" };", {"principal": "Group::\"staff\"", "action": "Action::\"read\"", "resource": "Photo::\"p1\"", "context": {"mfa": false, "n": 3, "neg": -3, "name": "report.pdf", "empty": "", "tags": ["x", "y"], "none": [], "nested": {"a": {"b": 1}}, "unicode": "日本語", "ip": {"__extn": {"fn": "ip", "arg": "10.0.0.5"}}, "dec": {"__extn": {"fn": "decimal", "arg": "1.5"}}, "at": {"__extn": {"fn": "datetime", "arg": "2024-10-15T11:35:00.123Z"}}, "dur": {"__extn": {"fn": "duration", "arg": "2h"}}, "who": {"__entity": {"type": "User", "id": "bob"}}}}, {"decision": "deny", "reasons": [], "errors": ["policy0"]}],
    ["permit (principal is Group, action == Action::\"edit\", resource == Photo::\"ghost\");\nforbid (principal in Group::\"all\", action in Action::\"read\", resource in Album::\"trip\") unless { context.who in Group::\"staff\" };", {"principal": "User::\"ghost\"", "action": "Action::\"edit\"", "resource": "Album::\"trip\"", "context": {"mfa": true, "n": 3, "neg": -3, "name": "report.pdf", "empty": "", "none": [], "nested": {"a": {"b": 1}}, "unicode": "日本語", "dec": {"__extn": {"fn": "decimal", "arg": "1.5"}}, "at": {"__extn": {"fn": "datetime", "arg": "2024-10-15T11:35:00.123Z"}}, "dur": {"__extn": {"fn": "duration", "arg": "2h"}}, "who": {"__entity": {"type": "User", "id": "bob"}}}}, {"decision": "deny", "reasons": [], "errors": []}],
    ["permit (principal is User in Group::\"all\", action == Action::\"view\", resource in Album::\"all\");", {"principal": "User::\"bob\"", "action": "Action::\"edit\"", "resource": "Album::\"trip\"", "context": {"mfa": false, "n": 3, "neg": -3, "name": "report.pdf", "empty": "", "tags": ["x", "y"], "none": [], "nested": {"a": {"b": 1}}, "unicode": "日本語", "ip": {"__extn": {"fn": "ip", "arg": "10.0.0.5"}}, "dec": {"__extn": {"fn": "decimal", "arg": "1.5"}}, "at": {"__extn": {"fn": "datetime", "arg": "2024-10-15T11:35:00.123Z"}}, "dur": {"__extn": {"fn": "duration", "arg": "2h"}}, "who": {"__entity": {"type": "User", "id": "bob"}}}}, {"decision": "deny", "reasons": [], "errors": []}],
    ["permit (principal == User::\"bob\", action == Action::\"view\", resource in Album::\"trip\");\nforbid (principal in Group::\"staff\", action == Action::\"edit\", resource in Album::\"work\");\npermit (principal == User::\"alice\", action in Action::\"read\", resource in Album::\"trip\") when { resource has owner && resource.owner in Group::\"staff\" };", {"principal": "Group::\"staff\"", "action": "Action::\"view\"", "resource": "Photo::\"p2\"", "context": {}}, {"decision": "deny", "reasons": [], "errors": []}],
