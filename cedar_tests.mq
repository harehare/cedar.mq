    ["permit (principal, action, resource in Album::\"work\") when { principal.getTag(\"role\") == \"admin\" };\npermit (principal is Group, action == Action::\"edit\", resource is Photo in Album::\"all\");\nforbid (principal is User, action in [], resource == Photo::\"ghost\");", {"principal": "User::\"bob\"", "action": "Action::\"read\"", "resource": "Photo::\"p1\"", "context": {"mfa": true, "n": 3, "neg": -3, "name": "report.pdf", "empty": "", "none": [], "nested": {"a": {"b": 1}}, "unicode": "日本語", "dec": {"__extn": {"fn": "decimal", "arg": "1.5"}}, "at": {"__extn": {"fn": "datetime", "arg": "2024-10-15T11:35:00.123Z"}}, "dur": {"__extn": {"fn": "duration", "arg": "2h"}}, "who": {"__entity": {"type": "User", "id": "bob"}}}}, {"decision": "deny", "reasons": [], "errors": []}],
