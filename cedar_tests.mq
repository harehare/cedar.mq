    ["duration(\"1h\").toDays()", "0"],
    ["duration(\"-1h\").toMilliseconds()", "-3600000"],
    ["duration(\"-1h\").toSeconds()", "-3600"],
    ["duration(\"-1h\").toMinutes()", "-60"],
    ["duration(\"-1h\").toHours()", "-1"],
    ["duration(\"-1h\").toDays()", "0"],
    ["duration(\"1d\").toMilliseconds()", "86400000"],
    ["duration(\"1d\").toSeconds()", "86400"],
