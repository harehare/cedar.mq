def test_conformance_datetime_duration_3():
  let failures = _conf_failures([
    ["duration(\"1s\").toMilliseconds()", "1000"],
    ["duration(\"1s\").toSeconds()", "1"],
    ["duration(\"1s\").toMinutes()", "0"],
