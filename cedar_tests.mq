    ["\"a*b\" like \"a*b\"", "true"],
    ["\"xyz\" like \"\\u{41}*\"", "false"],
    ["\"xyz\" like \"\\\\\"", "false"],
    ["\"\\\\\" like \"a*b\"", "false"],
    ["\"a\\nb\" like \"\\\"", "ERR"],
    ["\"a*\" like \"*port*\"", "false"],
    ["\"\\\\\" like \"x*y*z\"", "false"],
    ["\"ab.ab\" like \"\\\"\"", "false"],
    ["\"aa\" like \"\\q\"", "ERR"],
    ["\"**\" like \"\\0\"", "false"]
  ])
  | assert_eq(failures, [])
end

