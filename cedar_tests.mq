def test_conformance_constructors():
  let failures = _conf_failures([
    ["ip(\"\")", "ERR"],
    ["ip(\"1.2.3.4\")", "ip(\"1.2.3.4\")"],
    ["ip(\"0.0.0.0\")", "ip(\"0.0.0.0\")"],
    ["ip(\"255.255.255.255\")", "ip(\"255.255.255.255\")"],
    ["ip(\"256.1.1.1\")", "ERR"],
    ["ip(\"1.2.3\")", "ERR"],
    ["ip(\"1.2.3.4.5\")", "ERR"],
    ["ip(\"01.2.3.4\")", "ERR"],
    ["ip(\"1.2.3.04\")", "ERR"],
    ["ip(\"+1.2.3.4\")", "ERR"],
    ["ip(\" 1.2.3.4\")", "ERR"],
    ["ip(\"1.2.3.4 \")", "ERR"],
    ["ip(\"1.2.3.4/0\")", "ip(\"1.2.3.4/0\")"],
    ["ip(\"1.2.3.4/32\")", "ip(\"1.2.3.4/32\")"],
    ["ip(\"1.2.3.4/33\")", "ERR"],
    ["ip(\"1.2.3.4/\")", "ERR"],
    ["ip(\"1.2.3.4/-1\")", "ERR"],
    ["ip(\"1.2.3.4/+8\")", "ERR"],
    ["ip(\"1.2.3.4/08\")", "ERR"],
    ["ip(\"1.2.3.4/8/8\")", "ERR"],
    ["ip(\"/8\")", "ERR"],
    ["ip(\"::\")", "ip(\"::\")"],
