def test_conformance_extension_compare():
  let failures = _conf_failures([
    ["duration(\"1ms\") > duration(\"1ms\")", "false"],
    ["decimal(\"1.00\").greaterThanOrEqual(decimal(\"1.0\"))", "true"],
    ["ip(\"::ffff:102:304\") == ip(\"0.0.0.0/0\")", "false"],
    ["ip(\"::/0\") == ip(\"1.2.3.4/32\")", "false"],
    ["duration(\"0ms\") <= duration(\"1ms\")", "true"],
    ["decimal(\"1.5\") == decimal(\"1.00\")", "false"],
    ["datetime(\"2024-10-14T23:00:00-0100\") >= datetime(\"2024-10-15T00:00:00Z\")", "true"],
    ["decimal(\"-0.0\").lessThanOrEqual(decimal(\"-1.5\"))", "false"],
    ["decimal(\"1.0\").lessThan(decimal(\"1.0\"))", "false"],
    ["decimal(\"-1.5\") == decimal(\"-1.5\")", "true"],
    ["datetime(\"2024-10-14T23:00:00-0100\") > datetime(\"1969-12-31\")", "true"],
    ["duration(\"1d\") >= duration(\"-1d\")", "true"],
    ["datetime(\"1969-12-31\") > datetime(\"2024-10-15T00:00:00Z\")", "false"],
    ["duration(\"1ms\") < duration(\"1ms\")", "false"],
    ["ip(\"1.2.3.4/24\").isInRange(ip(\"1.2.3.4\"))", "false"],
    ["datetime(\"2024-10-15\") == datetime(\"2024-10-15T00:00:00Z\")", "true"],
    ["datetime(\"2024-10-15\") == datetime(\"2024-10-15\")", "true"],
    ["duration(\"-1ms\") >= duration(\"-1ms\")", "true"],
    ["duration(\"1ms\") == duration(\"1d\")", "false"],
    ["ip(\"1.2.3.0/24\").isInRange(ip(\"::/0\"))", "false"],
    ["decimal(\"-0.0001\").lessThan(decimal(\"-0.0001\"))", "false"],
    ["datetime(\"2024-10-15\").durationSince(datetime(\"2024-10-15T01:00:00+0100\"))", "duration(\"0ms\")"],
    ["duration(\"-1d\") < duration(\"-1ms\")", "true"],
    ["ip(\"1.2.3.4/24\") == ip(\"1.2.3.0/24\")", "false"],
    ["decimal(\"-0.0001\").lessThanOrEqual(decimal(\"-1.4999\"))", "false"],
    ["datetime(\"2024-10-14T23:00:00-0100\") >= datetime(\"2024-10-15T01:00:00+0100\")", "true"],
    ["ip(\"1.2.3.4/24\").isInRange(ip(\"1.2.3.4/24\"))", "true"],
    ["datetime(\"1969-12-31\").durationSince(datetime(\"2024-10-15T00:00:00.001Z\"))", "duration(\"-1729036800001ms\")"],
    ["datetime(\"2024-10-15T00:00:00Z\") != datetime(\"2024-10-15T00:00:00Z\")", "false"],
    ["duration(\"-1ms\") >= duration(\"1d\")", "false"],
    ["datetime(\"2024-10-15T01:00:00+0100\") != datetime(\"1970-01-01\")", "true"],
    ["decimal(\"-0.0\").lessThanOrEqual(decimal(\"-0.0001\"))", "false"],
    ["duration(\"0ms\") > duration(\"24h\")", "false"],
    ["decimal(\"-1.4999\").lessThanOrEqual(decimal(\"0.0001\"))", "true"],
    ["ip(\"0:0:0:0:0:0:0:1\").isInRange(ip(\"1.2.3.4\"))", "false"],
    ["datetime(\"1970-01-01\") >= datetime(\"2024-10-14T23:00:00-0100\")", "false"],
    ["duration(\"1ms\") == duration(\"0ms\")", "false"],
    ["decimal(\"-0.0\").greaterThan(decimal(\"1.0\"))", "false"],
    ["datetime(\"2024-10-15T00:00:00Z\").durationSince(datetime(\"2024-10-15\"))", "duration(\"0ms\")"],
    ["duration(\"-1d\") < duration(\"1ms\")", "true"],
    ["duration(\"0ms\") >= duration(\"-1ms\")", "true"],
    ["duration(\"-1d\") == duration(\"24h\")", "false"],
    ["datetime(\"1970-01-01\") != datetime(\"2024-10-15T00:00:00Z\")", "true"],
    ["datetime(\"2024-10-15T00:00:00.001Z\") <= datetime(\"2024-10-14T23:00:00-0100\")", "false"],
    ["decimal(\"-0.0001\").lessThanOrEqual(decimal(\"01.0\"))", "true"],
    ["ip(\"1.2.3.0/24\") == ip(\"1.2.3.4/32\")", "false"],
    ["ip(\"1.2.3.4\").isInRange(ip(\"1.2.3.4\"))", "true"],
    ["ip(\"0.0.0.0/0\").isInRange(ip(\"1.2.3.4/32\"))", "false"],
    ["datetime(\"2024-10-15\").durationSince(datetime(\"2024-10-15T00:00:00Z\"))", "duration(\"0ms\")"],
    ["decimal(\"1.0\").lessThan(decimal(\"-1.4999\"))", "false"],
    ["decimal(\"1.00\").lessThanOrEqual(decimal(\"0.0001\"))", "false"],
    ["decimal(\"-0.0\").greaterThanOrEqual(decimal(\"1.0\"))", "false"],
    ["decimal(\"1.5\").greaterThan(decimal(\"-0.0001\"))", "true"],
    ["datetime(\"2024-10-15\").durationSince(datetime(\"2024-10-14T23:00:00-0100\"))", "duration(\"0ms\")"],
    ["datetime(\"1969-12-31\") <= datetime(\"1970-01-01\")", "true"],
    ["datetime(\"2024-10-15T00:00:00Z\") == datetime(\"1970-01-01\")", "false"],
    ["ip(\"::1\").isInRange(ip(\"1.2.3.4/32\"))", "false"],
    ["duration(\"24h\") == duration(\"-1d\")", "false"],
    ["decimal(\"01.0\").lessThan(decimal(\"-0.0\"))", "false"],
    ["decimal(\"0.0001\").lessThan(decimal(\"-1.4999\"))", "false"],
    ["ip(\"::/0\").isInRange(ip(\"1.2.3.0/24\"))", "false"],
    ["datetime(\"1970-01-01\") <= datetime(\"2024-10-14T23:00:00-0100\")", "true"],
    ["decimal(\"01.0\").lessThan(decimal(\"-1.5\"))", "false"],
    ["ip(\"0.0.0.0/0\").isInRange(ip(\"::ffff:1.2.3.4\"))", "ERR"],
    ["decimal(\"0.0001\") == decimal(\"1.0\")", "false"],
    ["decimal(\"-0.0\").greaterThanOrEqual(decimal(\"1.5\"))", "false"],
    ["duration(\"90m\") < duration(\"-1ms\")", "false"],
    ["duration(\"90m\") >= duration(\"-1d\")", "true"],
    ["datetime(\"2024-10-15T00:00:00Z\").durationSince(datetime(\"1969-12-31\"))", "duration(\"1729036800000ms\")"],
    ["ip(\"0:0:0:0:0:0:0:1\").isInRange(ip(\"0:0:0:0:0:0:0:1\"))", "true"],
    ["decimal(\"1.5\").greaterThanOrEqual(decimal(\"-1.4999\"))", "true"],
    ["decimal(\"01.0\").lessThanOrEqual(decimal(\"-0.0\"))", "false"],
    ["ip(\"::ffff:1.2.3.4\").isInRange(ip(\"::ffff:1.2.3.4\"))", "ERR"],
    ["ip(\"::1/128\") == ip(\"::ffff:1.2.3.4\")", "ERR"],
    ["duration(\"1h30m\") >= duration(\"0ms\")", "true"],
    ["datetime(\"2024-10-15T01:00:00+0100\") < datetime(\"2024-10-15\")", "false"],
    ["decimal(\"-1.5\").greaterThan(decimal(\"-0.0\"))", "false"],
    ["duration(\"0ms\") <= duration(\"-1ms\")", "false"],
    ["duration(\"1d\") > duration(\"1h30m\")", "true"],
    ["datetime(\"1970-01-01\") < datetime(\"2024-10-14T23:00:00-0100\")", "true"],
    ["decimal(\"1.0\") == decimal(\"1.00\")", "true"],
    ["decimal(\"0.0001\").greaterThan(decimal(\"-1.5\"))", "true"],
    ["duration(\"1h30m\") < duration(\"0ms\")", "false"],
    ["datetime(\"2024-10-15\") == datetime(\"1970-01-01\")", "false"],
    ["datetime(\"1970-01-01\") == datetime(\"1970-01-01\")", "true"],
    ["datetime(\"2024-10-14T23:00:00-0100\") < datetime(\"2024-10-14T23:00:00-0100\")", "false"],
    ["duration(\"1ms\") >= duration(\"1ms\")", "true"],
    ["decimal(\"01.0\") == decimal(\"1.5\")", "false"],
    ["decimal(\"1.00\").greaterThanOrEqual(decimal(\"1.5\"))", "false"],
    ["duration(\"1ms\") > duration(\"-1ms\")", "true"],
    ["duration(\"1ms\") == duration(\"90m\")", "false"],
    ["duration(\"1h30m\") >= duration(\"90m\")", "true"],
    ["datetime(\"2024-10-15T00:00:00.001Z\") < datetime(\"1969-12-31\")", "false"],
    ["datetime(\"2024-10-14T23:00:00-0100\") <= datetime(\"2024-10-15T01:00:00+0100\")", "true"],
    ["ip(\"1.2.3.0/24\") == ip(\"1.2.3.4/24\")", "false"],
    ["duration(\"24h\") > duration(\"-1ms\")", "true"],
    ["decimal(\"-1.5\").lessThanOrEqual(decimal(\"01.0\"))", "true"],
    ["datetime(\"2024-10-15\") <= datetime(\"2024-10-15\")", "true"],
    ["decimal(\"-1.5\").greaterThan(decimal(\"0.0\"))", "false"],
    ["duration(\"1d\") <= duration(\"0ms\")", "false"]
  ])
  | assert_eq(failures, [])
end

def test_conformance_ip_ranges():
  let failures = _conf_failures([
    ["ip(\"192.168.0.0/24\").isInRange(ip(\"0.0.0.0/0\"))", "true"],
    ["ip(\"10.0.0.0/8\").isInRange(ip(\"10.0.0.0/8\"))", "true"],
    ["ip(\"255.255.255.255\").isInRange(ip(\"0.0.0.0/0\"))", "true"],
    ["ip(\"192.168.0.1/24\").isInRange(ip(\"192.168.0.1/24\"))", "true"],
    ["ip(\"127.0.0.1\").isIpv4()", "true"],
    ["ip(\"2001:db8::/32\").isInRange(ip(\"192.168.0.1\"))", "false"],
    ["ip(\"::\").isLoopback()", "false"],
    ["ip(\"2001:db8::1\").isInRange(ip(\"2001:db8:1::/48\"))", "false"],
    ["ip(\"ff00::/7\").isMulticast()", "false"],
    ["ip(\"ff00::/7\").isLoopback()", "false"],
    ["ip(\"::\").isMulticast()", "false"],
    ["ip(\"::\").isIpv4()", "false"],
    ["ip(\"240.0.0.0\").isIpv6()", "false"],
    ["ip(\"192.168.0.255/24\").isInRange(ip(\"192.168.0.1/24\"))", "true"],
    ["ip(\"192.168.0.1/28\").isInRange(ip(\"255.255.255.255\"))", "false"],
    ["ip(\"::\").isIpv6()", "true"],
    ["ip(\"192.168.0.255/24\").isInRange(ip(\"0.0.0.0/0\"))", "true"],
    ["ip(\"2001:db8::1\").isInRange(ip(\"2001:db8::1\"))", "true"],
