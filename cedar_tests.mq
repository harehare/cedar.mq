    ["permit (principal, action, resource) when { {\"if\": 1}[\"if\"] };", true],
    ["permit (principal, action, resource) when { context.a is_ };", false]
  ], fn(c): _conf_parses(c[0]) != c[1];), fn(c): c[0];)
  | assert_eq(failures, [])
end

# Policy texts and the Cedar CLI's JSON policy for them (`has` paths expanded, as cedar_parse does).
def test_conformance_parse_ast():
  let failures = map(filter([
    ["permit (principal, action, resource);", {"effect": "permit", "principal": {"op": "All"}, "action": {"op": "All"}, "resource": {"op": "All"}, "conditions": [], "annotations": {}}],
    ["permit (principal, action, resource) ;", {"effect": "permit", "principal": {"op": "All"}, "action": {"op": "All"}, "resource": {"op": "All"}, "conditions": [], "annotations": {}}],
    ["permit(principal,action,resource);", {"effect": "permit", "principal": {"op": "All"}, "action": {"op": "All"}, "resource": {"op": "All"}, "conditions": [], "annotations": {}}],
    ["forbid (principal, action, resource);", {"effect": "forbid", "principal": {"op": "All"}, "action": {"op": "All"}, "resource": {"op": "All"}, "conditions": [], "annotations": {}}],
    ["permit (principal, action, resource,);", {"effect": "permit", "principal": {"op": "All"}, "action": {"op": "All"}, "resource": {"op": "All"}, "conditions": [], "annotations": {}}],
    ["permit (principal, action, resource) when { true };", {"effect": "permit", "principal": {"op": "All"}, "action": {"op": "All"}, "resource": {"op": "All"}, "conditions": [{"kind": "when", "body": {"Value": true}}], "annotations": {}}],
    ["permit (principal, action, resource) when { true } unless { false };", {"effect": "permit", "principal": {"op": "All"}, "action": {"op": "All"}, "resource": {"op": "All"}, "conditions": [{"kind": "when", "body": {"Value": true}}, {"kind": "unless", "body": {"Value": false}}], "annotations": {}}],
    ["permit (principal, action, resource) unless { false } when { true };", {"effect": "permit", "principal": {"op": "All"}, "action": {"op": "All"}, "resource": {"op": "All"}, "conditions": [{"kind": "unless", "body": {"Value": false}}, {"kind": "when", "body": {"Value": true}}], "annotations": {}}],
    ["permit (principal, action, resource) when { true } when { true };", {"effect": "permit", "principal": {"op": "All"}, "action": {"op": "All"}, "resource": {"op": "All"}, "conditions": [{"kind": "when", "body": {"Value": true}}, {"kind": "when", "body": {"Value": true}}], "annotations": {}}],
    ["@id(\"a\") permit (principal, action, resource);", {"effect": "permit", "principal": {"op": "All"}, "action": {"op": "All"}, "resource": {"op": "All"}, "conditions": [], "annotations": {"id": "a"}}],
    ["@id permit (principal, action, resource);", {"effect": "permit", "principal": {"op": "All"}, "action": {"op": "All"}, "resource": {"op": "All"}, "conditions": [], "annotations": {"id": None}}],
