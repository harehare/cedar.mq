    ["context.tags.contains(\"x\")", "true"],
    ["context.ip.isInRange(ip(\"10.0.0.0/8\"))", "true"],
    ["context.dec.lessThan(decimal(\"2.0\"))", "true"],
    ["context.at.toTime()", "duration(\"41700123ms\")"],
    ["context.at.toDate()", "datetime(\"1970-01-01\").offset(duration(\"1728950400000ms\"))"],
    ["context.at < datetime(\"2025-01-01\")", "true"],
    ["context.dur > duration(\"1h\")", "true"],
    ["principal.score.lessThan(decimal(\"3.0\"))", "true"],
    ["principal.score == decimal(\"2.5\")", "true"],
    ["principal.addr.isInRange(ip(\"10.0.0.0/8\"))", "true"],
    ["principal.since.toDate()", "datetime(\"1970-01-01\").offset(duration(\"1728950400000ms\"))"],
    ["principal.ttl.toMinutes()", "90"],
    ["principal.ttl == duration(\"90m\")", "true"],
    ["resource.owner.manager.name", "\"Bob\""],
    ["resource.owner == principal", "true"],
    ["resource.owner in Group::\"all\"", "true"],
    ["principal.nums.containsAll([1, 3])", "true"],
    ["principal.tags.containsAny([\"z\", \"b\"])", "true"],
