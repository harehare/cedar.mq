    ["[1, 2] == [2, 1]", "true"],
    ["[[1, 2], [3]] == [[3], [2, 1]]", "true"],
    ["{a: [1, 2]} == {a: [2, 1]}", "true"],
    ["{a: 1, b: 2} == {b: 2, a: 1}", "true"],
    ["[ip(\"1.1.1.1\")] == [ip(\"1.1.1.1/32\")]", "true"],
    ["[decimal(\"1.0\"), decimal(\"1.00\")] == [decimal(\"1.0\")]", "true"],
    ["\"a\\u{41}\"", "\"aA\""],
    ["\"\\u{1F600}\"", "\"😀\""],
