    ["permit (principal, action, resource) when { 1 in 2 == true };", false],
    ["permit (principal, action, resource) when { 1 + 2 in 3 };", true],
    ["permit (principal, action, resource) when { 1 like \"a\" like \"b\" };", false],
    ["permit (principal, action, resource) when { principal has a has b };", false],
    ["permit (principal, action, resource) when { principal is User is User };", false],
    ["permit (principal, action, resource) when { principal is User && true };", true],
    ["permit (principal, action, resource) when { principal is User in Group::\"a\" && true };", true],
    ["permit (principal, action, resource) when { principal is User in Group::\"a\" in Group::\"b\" };", false],
    ["permit (principal, action, resource) when { principal is User == true };", false],
    ["permit (principal, action, resource) when { 1 + principal is User };", true],
    ["permit (principal, action, resource) when { if true then 1 else 2 };", true],
