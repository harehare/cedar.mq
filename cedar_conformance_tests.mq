    ["@id(\"p0\") permit (principal is User in Group::\"all\", action in Action::\"read\", resource in Album::\"work\") unless { context.n > 2 } unless { context.missing } unless { resource has owner && resource.owner in Group::\"staff\" };\npermit (principal is User in Group::\"all\", action, resource in Album::\"work\");\npermit (principal in Group::\"staff\", action == Action::\"view\", resource == Photo::\"ghost\") when { context.ip.isInRange(ip(\"10.0.0.0/8\")) } when { context has nested.x.y } unless { true };\npermit (principal is User in Group::\"all\", action == Action::\"view\", resource in Album::\"all\") when { resource.public } when { principal.age < 18 };\npermit (principal is Group, action, resource is Album) unless { resource.owner == principal };", {"principal": "User::\"alice\"", "action": "Action::\"edit\"", "resource": "Photo::\"p2\"", "context": {"mfa": true, "n": 3, "neg": -3, "name": "report.pdf", "empty": "", "none": [], "nested": {"a": {"b": 1}}, "unicode": "日本語", "dec": {"__extn": {"fn": "decimal", "arg": "1.5"}}, "at": {"__extn": {"fn": "datetime", "arg": "2024-10-15T11:35:00.123Z"}}, "dur": {"__extn": {"fn": "duration", "arg": "2h"}}, "who": {"__entity": {"type": "User", "id": "bob"}}}}, {"decision": "allow", "reasons": ["policy1"], "errors": []}],
    ["permit (principal in Group::\"all\", action == Action::\"view\", resource in Album::\"work\") when { context.who in Group::\"staff\" };\nforbid (principal is Group, action == Action::\"edit\", resource in Album::\"trip\") when { principal.getTag(\"role\") == \"admin\" } when { resource has owner && resource.owner in Group::\"staff\" };", {"principal": "User::\"alice\"", "action": "Action::\"edit\"", "resource": "Photo::\"p1\"", "context": {}}, {"decision": "deny", "reasons": [], "errors": []}],
