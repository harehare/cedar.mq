    ["permit (principal, action, resource) when { ip() };", true],
    ["permit (principal, action, resource) when { ip(\"a\", \"b\") };", true],
    ["permit (principal, action, resource) when { decimal(\"1.0\").lessThan(decimal(\"2.0\")) };", true],
    ["permit (principal, action, resource) when { Ns::fn(1) };", false],
    ["permit (principal, action, resource) when { fn(1) };", false],
    ["permit (principal, action, resource) when { ip };", false],
    ["permit (principal, action, resource) when { ip(\"1.1.1.1\").isInRange(ip(\"1.0.0.0/8\")) };", true],
    ["permit (principal, action, resource) when { datetime(\"2024-01-01\").toDate() };", true],
    ["permit (principal, action, resource) when { duration(\"1h\").toHours() };", true],
    ["permit (principal, action, resource) when { User::\"a\" };", true],
    ["permit (principal, action, resource) when { User::\"a\".name };", true],
    ["permit (principal, action, resource) when { User::\"a\" in Group::\"b\" };", true],
    ["permit (principal, action, resource) when { Ns::User::\"a\" };", true],
    ["permit (principal, action, resource) when { User::\"a\"::\"b\" };", false],
    ["permit (principal, action, resource) when { User:: \"a\" };", true],
    ["permit (principal, action, resource) when { User ::\"a\" };", true],
    ["permit (principal, action, resource) when { User };", false],
    ["permit (principal, action, resource) when { Ns::User };", false],
    ["permit (principal, action, resource) when { Ns::User.name };", false],
    ["permit (principal, action, resource) when { principal.name };", true],
    ["permit (principal, action, resource) when { principal . name };", true],
    ["permit (principal, action, resource) when { principal.\nname };", true],
    ["permit (principal, action, resource) when { principal // c\n.name };", true],
    ["permit (principal, action, resource) when { action == Action::\"a\" };", true],
    ["permit (principal, action, resource) when { resource };", true],
    ["permit (principal, action, resource) when { context };", true],
    ["permit (principal, action, resource) when { principal };", true],
    ["permit (principal, action, resource) when { Principal };", false],
    ["permit (principal, action, resource) when { ?principal == principal };", false],
    ["permit (principal, action, resource) when { principal == ?principal };", false],
    ["permit (principal, action, resource) when { ?resource };", false],
    ["permit (principal, action, resource) when { ?foo };", false],
    ["permit (principal, action, resource) when { \"a\" like \"a*\" };", true],
    ["permit (principal, action, resource) when { \"a\" like \"a\\*\" };", true],
    ["permit (principal, action, resource) when { \"a\" like \"a\\**\" };", true],
    ["permit (principal, action, resource) when { \"a\" like a };", false],
    ["permit (principal, action, resource) when { \"a\" like \"\\q\" };", false],
    ["permit (principal, action, resource) when { \"a\" like \"\\u{41}*\" };", true],
    ["permit (principal, action, resource) when { \"a\" like \"a**b\" };", true],
    ["permit (principal, action, resource) when { \"a\" like \"*\" };", true],
    ["permit (principal, action, resource) when { \"a*\" == \"a\\*\" };", false],
    ["permit (principal, action, resource) when { \"a\\*\" == \"a\" };", false],
