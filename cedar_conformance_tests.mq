    ["@id(\"p0\") permit (principal, action == Action::\"view\", resource);\n@id(\"p1\") permit (principal in Group::\"all\", action in [], resource in Album::\"work\");", {"principal": "User::\"alice\"", "action": "Action::\"other\"", "resource": "Photo::\"ghost\"", "context": {"mfa": true, "n": 1, "neg": -3, "name": "report.pdf", "empty": "", "tags": ["x"], "none": [], "nested": {"a": {"b": 1}}, "unicode": "日本語", "ip": {"__extn": {"fn": "ip", "arg": "10.0.0.5"}}, "dec": {"__extn": {"fn": "decimal", "arg": "1.5"}}, "at": {"__extn": {"fn": "datetime", "arg": "2024-10-15T11:35:00.123Z"}}, "dur": {"__extn": {"fn": "duration", "arg": "2h"}}, "who": {"__entity": {"type": "User", "id": "bob"}}}}, {"decision": "deny", "reasons": [], "errors": []}],
    ["permit (principal is Group, action == Action::\"view\", resource is Photo) when { principal.getTag(\"role\") == \"admin\" };\n@id(\"p1\") permit (principal is User, action == Action::\"edit\", resource in Album::\"trip\");", {"principal": "Group::\"staff\"", "action": "Action::\"view\"", "resource": "Photo::\"p1\"", "context": {"mfa": true, "n": 1, "neg": -3, "name": "report.pdf", "empty": "", "tags": ["x"], "none": [], "nested": {"a": {"b": 1}}, "unicode": "日本語", "ip": {"__extn": {"fn": "ip", "arg": "10.0.0.5"}}, "dec": {"__extn": {"fn": "decimal", "arg": "1.5"}}, "at": {"__extn": {"fn": "datetime", "arg": "2024-10-15T11:35:00.123Z"}}, "dur": {"__extn": {"fn": "duration", "arg": "2h"}}, "who": {"__entity": {"type": "User", "id": "bob"}}}}, {"decision": "deny", "reasons": [], "errors": ["policy0"]}],
    ["permit (principal in User::\"ghost\", action == Action::\"view\", resource in Album::\"trip\") unless { context.mfa };\npermit (principal in Group::\"all\", action in [Action::\"view\", Action::\"edit\"], resource in Album::\"work\") unless { principal.getTag(\"role\") == \"admin\" } unless { context.n > 2 } unless { context.n > 2 };\npermit (principal is User in Group::\"staff\", action in [], resource in Album::\"trip\") unless { true };\npermit (principal in Group::\"staff\", action in Action::\"read\", resource in Album::\"trip\");\n@id(\"p4\") permit (principal is User, action, resource is Album);", {"principal": "User::\"ghost\"", "action": "Action::\"other\"", "resource": "Album::\"trip\"", "context": {"mfa": true, "n": 1, "neg": -3, "name": "report.pdf", "empty": "", "tags": ["x"], "none": [], "nested": {"a": {"b": 1}}, "unicode": "日本語", "ip": {"__extn": {"fn": "ip", "arg": "10.0.0.5"}}, "dec": {"__extn": {"fn": "decimal", "arg": "1.5"}}, "at": {"__extn": {"fn": "datetime", "arg": "2024-10-15T11:35:00.123Z"}}, "dur": {"__extn": {"fn": "duration", "arg": "2h"}}, "who": {"__entity": {"type": "User", "id": "bob"}}}}, {"decision": "allow", "reasons": ["p4"], "errors": []}],
    ["@id(\"p0\") permit (principal is User in Group::\"all\", action == Action::\"edit\", resource in Album::\"all\") unless { context.at < datetime(\"2025-01-01\") } when { context.missing };\nforbid (principal in Group::\"all\", action == Action::\"view\", resource is Album) when { context.who in Group::\"staff\" } unless { context.tags.contains(\"x\") } when { \"abc\" like \"a*\" };", {"principal": "User::\"alice\"", "action": "Action::\"view\"", "resource": "Photo::\"ghost\"", "context": {}}, {"decision": "deny", "reasons": [], "errors": []}]
  ])
  | assert_eq(failures, [])
end

def _conf_parses(text):
  try: do cedar_parse(text) | true end catch(e): false
end

# Policy texts and whether the Cedar CLI accepts them.
def test_conformance_parse_acceptance():
  let failures = map(filter([
    ["", true],
    [" ", true],
    ["// c", true],
    ["permit (principal, action, resource);", true],
    ["permit (principal, action, resource)", false],
    ["permit (principal, action, resource) ;", true],
    ["permit(principal,action,resource);", true],
    ["forbid (principal, action, resource);", true],
    ["Permit (principal, action, resource);", false],
    ["allow (principal, action, resource);", false],
    ["permit (principal, action);", false],
    ["permit (principal, action, resource, context);", false],
    ["permit (action, principal, resource);", false],
    ["permit (principal, action, resource,);", true],
    ["permit (principal,, action, resource);", false],
    ["permit ();", false],
    ["permit principal, action, resource;", false],
    ["permit (principal, action, resource); permit (principal, action, resource);", true],
    ["permit (principal, action, resource);;", false],
    ["permit (principal, action, resource);\npermit (principal, action, resource)", false],
    ["permit (principal, action, resource) when { true };", true],
    ["permit (principal, action, resource) when { true }", false],
    ["permit (principal, action, resource) when {};", false],
    ["permit (principal, action, resource) when { true } unless { false };", true],
    ["permit (principal, action, resource) unless { false } when { true };", true],
    ["permit (principal, action, resource) when { true } when { true };", true],
    ["permit (principal, action, resource) when true;", false],
    ["permit (principal, action, resource) where { true };", false],
    ["permit (principal, action, resource) when { true; };", false],
    ["permit (principal, action, resource) when { true, false };", false],
    ["@id(\"a\") permit (principal, action, resource);", true],
    ["@id permit (principal, action, resource);", true],
    ["@id() permit (principal, action, resource);", false],
    ["@id(a) permit (principal, action, resource);", false],
    ["@id(\"a\") @doc(\"b\") permit (principal, action, resource);", true],
    ["@id(\"a\") @id(\"b\") permit (principal, action, resource);", false],
    ["@a1_b(\"x\") permit (principal, action, resource);", true],
    ["@1a(\"x\") permit (principal, action, resource);", false],
    ["@if(\"x\") permit (principal, action, resource);", true],
    ["@permit(\"x\") permit (principal, action, resource);", true],
    ["@id(\"a\")\n@doc(\"b\")\npermit (principal, action, resource);", true],
    ["@id(\"a\"permit (principal, action, resource);", false],
    ["@ id(\"a\") permit (principal, action, resource);", true],
    ["@id (\"a\") permit (principal, action, resource);", true],
    ["@Ns::id(\"a\") permit (principal, action, resource);", false],
    ["@id(\"\") permit (principal, action, resource);", true],
    ["permit (principal == User::\"a\", action, resource);", true],
    ["permit (principal in User::\"a\", action, resource);", true],
    ["permit (principal is User, action, resource);", true],
    ["permit (principal is User in Group::\"g\", action, resource);", true],
    ["permit (principal is Ns::User, action, resource);", true],
    ["permit (principal is User in ?principal, action, resource);", true],
    ["permit (principal == ?principal, action, resource);", true],
    ["permit (principal == ?resource, action, resource);", false],
    ["permit (principal, action, resource == ?resource);", true],
    ["permit (principal in ?principal, action, resource in ?resource);", true],
    ["permit (principal in [User::\"a\"], action, resource);", false],
    ["permit (principal, action == Action::\"a\", resource);", true],
    ["permit (principal, action in Action::\"a\", resource);", true],
    ["permit (principal, action in [Action::\"a\", Action::\"b\"], resource);", true],
    ["permit (principal, action in [], resource);", true],
    ["permit (principal, action in [Action::\"a\",], resource);", true],
    ["permit (principal, action in [Action::\"a\" Action::\"b\"], resource);", false],
    ["permit (principal, action is Action, resource);", false],
    ["permit (principal, action == ?action, resource);", false],
    ["permit (principal, action in [?action], resource);", false],
    ["permit (principal, action, resource is Photo in Album::\"a\");", true],
    ["permit (principal, action, resource in [Album::\"a\"]);", false],
    ["permit (principal == \"a\", action, resource);", false],
    ["permit (principal == User, action, resource);", false],
    ["permit (principal == User::a, action, resource);", false],
    ["permit (principal == User::\"a\"::\"b\", action, resource);", false],
    ["permit (principal == Ns::Sub::User::\"a\", action, resource);", true],
    ["permit (principal == _x::\"a\", action, resource);", true],
    ["permit (principal != User::\"a\", action, resource);", false],
    ["permit (principal <= User::\"a\", action, resource);", false],
    ["permit (principal like \"a\", action, resource);", false],
    ["permit (principal is, action, resource);", false],
    ["permit (principal is User in, action, resource);", false],
    ["permit (principal is User::\"a\", action, resource);", false],
    ["permit (principal == User::\"a\" , action , resource );", true],
    ["permit (principal == User :: \"a\", action, resource);", true],
    ["permit (principal==User::\"a\",action,resource);", true],
    ["permit (principal is principal, action, resource);", true],
    ["permit (principal is if, action, resource);", false],
    ["permit (principal is permit, action, resource);", true],
    ["permit (principal == User::\"a\\\"b\", action, resource);", true],
    ["permit (principal == User::\"\\u{41}\", action, resource);", true],
    ["permit (principal == User::\"\\q\", action, resource);", false],
    ["permit (principal == User::'a', action, resource);", false],
    ["permit (principal, action, resource) when { principal == User::\"a\" };", true],
    ["permit (principal, action, resource) when { context.a.b.c };", true],
    ["permit (principal, action, resource) when { context[\"a\"] };", true],
    ["permit (principal, action, resource) when { context[a] };", false],
    ["permit (principal, action, resource) when { context.a[0] };", false],
    ["permit (principal, action, resource) when { context.if };", false],
    ["permit (principal, action, resource) when { context.true };", false],
    ["permit (principal, action, resource) when { context.principal };", true],
    ["permit (principal, action, resource) when { context.has };", false],
    ["permit (principal, action, resource) when { context.in };", false],
    ["permit (principal, action, resource) when { context.like };", false],
    ["permit (principal, action, resource) when { context.is };", false],
    ["permit (principal, action, resource) when { context.permit };", true],
    ["permit (principal, action, resource) when { context.then };", false],
    ["permit (principal, action, resource) when { context has if };", false],
    ["permit (principal, action, resource) when { context has \"a b\" };", true],
    ["permit (principal, action, resource) when { context has a.b };", true],
    ["permit (principal, action, resource) when { context has a.if };", false],
    ["permit (principal, action, resource) when { context has a. };", false],
    ["permit (principal, action, resource) when { context has };", false],
    ["permit (principal, action, resource) when { context has 1 };", false],
    ["permit (principal, action, resource) when { context has a[\"b\"] };", false],
    ["permit (principal, action, resource) when { context has principal };", true],
    ["permit (principal, action, resource) when { context has true };", false],
    ["permit (principal, action, resource) when { 1 + 2 * 3 - 4 };", true],
    ["permit (principal, action, resource) when { -1 };", true],
    ["permit (principal, action, resource) when { - 1 };", true],
    ["permit (principal, action, resource) when { --1 };", true],
    ["permit (principal, action, resource) when { !-1 };", false],
    ["permit (principal, action, resource) when { -(1) };", true],
    ["permit (principal, action, resource) when { 1 - -1 };", true],
    ["permit (principal, action, resource) when { 1 +- 1 };", true],
    ["permit (principal, action, resource) when { 9223372036854775807 };", true],
    ["permit (principal, action, resource) when { 9223372036854775808 };", false],
    ["permit (principal, action, resource) when { -9223372036854775808 };", true],
    ["permit (principal, action, resource) when { -9223372036854775809 };", false],
    ["permit (principal, action, resource) when { 99999999999999999999999 };", false],
    ["permit (principal, action, resource) when { 01 };", true],
    ["permit (principal, action, resource) when { 0x10 };", false],
    ["permit (principal, action, resource) when { 1.5 };", false],
    ["permit (principal, action, resource) when { 1e3 };", false],
    ["permit (principal, action, resource) when { 1_000 };", false],
    ["permit (principal, action, resource) when { 1 / 2 };", false],
    ["permit (principal, action, resource) when { 1 % 2 };", false],
    ["permit (principal, action, resource) when { 1 & 2 };", false],
    ["permit (principal, action, resource) when { 1 ^ 2 };", false],
    ["permit (principal, action, resource) when { 1 << 2 };", false],
    ["permit (principal, action, resource) when { true && false || true };", true],
    ["permit (principal, action, resource) when { true and false };", false],
    ["permit (principal, action, resource) when { true or false };", false],
    ["permit (principal, action, resource) when { not true };", false],
    ["permit (principal, action, resource) when { !true };", true],
    ["permit (principal, action, resource) when { a == b == c };", false],
    ["permit (principal, action, resource) when { 1 < 2 < 3 };", false],
