    ["permit (principal in User::\"ghost\", action == Action::\"edit\", resource == Photo::\"p1\") unless { resource has owner && resource.owner in Group::\"staff\" } unless { principal.manager.name == \"Bob\" };", {"principal": "Group::\"staff\"", "action": "Action::\"edit\"", "resource": "Photo::\"ghost\"", "context": {"mfa": true, "n": 1, "neg": -3, "name": "report.pdf", "empty": "", "tags": ["x"], "none": [], "nested": {"a": {"b": 1}}, "unicode": "日本語", "ip": {"__extn": {"fn": "ip", "arg": "10.0.0.5"}}, "dec": {"__extn": {"fn": "decimal", "arg": "1.5"}}, "at": {"__extn": {"fn": "datetime", "arg": "2024-10-15T11:35:00.123Z"}}, "dur": {"__extn": {"fn": "duration", "arg": "2h"}}, "who": {"__entity": {"type": "User", "id": "bob"}}}}, {"decision": "deny", "reasons": [], "errors": []}],
