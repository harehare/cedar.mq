    ["permit (principal, action, resource) when { {a.b: 1} };", false],
    ["permit (principal, action, resource) when { {a: 1}.a };", true],
    ["permit (principal, action, resource) when { {a: 1}[\"a\"] };", true],
    ["permit (principal, action, resource) when { [1].contains(1) };", true],
    ["permit (principal, action, resource) when { [1].contains() };", false],
    ["permit (principal, action, resource) when { [1].contains(1, 2) };", false],
    ["permit (principal, action, resource) when { [1].isEmpty() };", true],
    ["permit (principal, action, resource) when { [1].isEmpty(1) };", false],
    ["permit (principal, action, resource) when { [1].foo(1) };", false],
    ["permit (principal, action, resource) when { context.a.foo() };", false],
    ["permit (principal, action, resource) when { context.a.contains(1).b };", true],
    ["permit (principal, action, resource) when { context.a.contains(1).contains(2) };", true],
    ["permit (principal, action, resource) when { context.a(1) };", false],
    ["permit (principal, action, resource) when { contains(1) };", false],
    ["permit (principal, action, resource) when { ip(\"1.1.1.1\") };", true],
