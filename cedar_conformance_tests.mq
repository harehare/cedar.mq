  ])
  | assert_eq(failures, [])
end

def _conf_authz_failures(trials):
  let ents = _conf_entities()
  | map(filter(trials, fn(t): !_conf_authz_ok(t, ents);), fn(t): t[0];)
end

def _conf_authz_ok(t, ents):
  try:
    do
      let r = cedar_is_authorized(t[0], t[1], ents)
      | r["decision"] == t[2]["decision"] && sort(r["reasons"]) == t[2]["reasons"]
        && sort(map(r["errors"], fn(e): e["policy"];)) == t[2]["errors"]
    end
  catch(e): false
end

def test_conformance_authorization_1():
  let failures = _conf_authz_failures([
    ["permit (principal is User in Group::\"staff\", action == Action::\"edit\", resource in Album::\"trip\");\npermit (principal == User::\"alice\", action in [], resource in Album::\"trip\") unless { 1 } when { principal.age >= 18 };\nforbid (principal in Group::\"all\", action, resource is Photo in Album::\"all\");\n@id(\"p3\") forbid (principal == User::\"alice\", action == Action::\"view\", resource == Photo::\"p1\") when { context.n > 2 };", {"principal": "User::\"alice\"", "action": "Action::\"other\"", "resource": "Photo::\"p2\"", "context": {"mfa": true, "n": 1, "neg": -3, "name": "report.pdf", "empty": "", "tags": ["x"], "none": [], "nested": {"a": {"b": 1}}, "unicode": "日本語", "ip": {"__extn": {"fn": "ip", "arg": "10.0.0.5"}}, "dec": {"__extn": {"fn": "decimal", "arg": "1.5"}}, "at": {"__extn": {"fn": "datetime", "arg": "2024-10-15T11:35:00.123Z"}}, "dur": {"__extn": {"fn": "duration", "arg": "2h"}}, "who": {"__entity": {"type": "User", "id": "bob"}}}}, {"decision": "deny", "reasons": [], "errors": []}],
