    ["permit (principal, action, resource) when { \"\\x80\" };", false],
    ["permit (principal, action, resource) when { \"\\u{0}\" };", true],
    ["permit (principal, action, resource) when { \"\\u{110000}\" };", false],
    ["permit (principal, action, resource) when { \"\\u{D800}\" };", false],
    ["permit (principal, action, resource) when { \"multi\nline\" };", true],
    ["permit (principal, action, resource) when { \"tab\there\" };", true],
    ["permit (principal, action, resource) when { \"unterminated };", false],
    ["permit (principal, action, resource) when { 'single' };", false],
    ["permit (principal, action, resource) when { \"日本語\" };", true],
    ["permit (principal, action, resource) when { \"😀\" };", true],
    ["permit (principal, action, resource) when { context.日本語 };", false],
    ["permit (principal, action, resource) when { context.a-b };", false],
    ["permit (principal, action, resource) when { context.a$b };", false],
    ["permit (principal, action, resource) when { context._a };", true],
    ["permit (principal, action, resource) when { context.a1 };", true],
    ["permit (principal, action, resource) when { context.1a };", false],
    ["permit (principal, action, resource) when { true } // trailing", false],
    ["permit (principal, action, resource) // c\nwhen { true };", true],
    ["permit (principal, action, resource) /* c */ when { true };", false],
    ["/* c */ permit (principal, action, resource);", false],
    ["permit (principal, action, resource) when { true /* c */ };", false],
    ["permit (principal, action, resource) when { context.a.b.c.d.e.f.g.h.i.j.k.l.m.n.o.p };", true],
    ["permit (principal, action, resource) when { ((((((((((1)))))))))) };", true],
    ["permit (principal, action, resource) when { ( };", false],
    ["permit (principal, action, resource) when { ) };", false],
    ["permit (principal, action, resource) when { () };", false],
    ["permit (principal, action, resource) when { principal in [User::\"a\", Group::\"b\"] };", true],
    ["permit (principal, action, resource) when { principal in [] };", true],
    ["permit (principal, action, resource) when { principal in User::\"a\" || principal in User::\"b\" };", true],
    ["permit (principal, action, resource) when { context.a == \"x\" && (context.b || context.c) };", true],
    ["permit (principal, action, resource) when { !(context.a) };", true],
    ["permit (principal, action, resource) when { !!context.a };", true],
    ["permit (principal, action, resource) when { !context.a.b };", true],
    ["permit (principal, action, resource) when { -context.a };", true],
    ["permit (principal, action, resource) when { context.a * -1 };", true],
    ["permit (principal, action, resource) when { 1 * 2 * 3 };", true],
    ["permit (principal, action, resource) when { 1 - 2 - 3 };", true],
    ["permit (principal, action, resource) when { 1 * (2 + 3) };", true],
    ["permit (principal, action, resource) when { principal == User::\"a\" } unless { resource == Photo::\"b\" } when { context.c };", true],
    ["permit (principal, action, resource) when { context.forbid };", true],
    ["permit (principal, action, resource) when { context.when };", true],
    ["permit (principal, action, resource) when { context.unless };", true],
    ["permit (principal, action, resource) when { context.else };", false],
    ["permit (principal, action, resource) when { context has when };", true],
    ["permit (principal, action, resource) when { context has else };", false],
    ["permit (principal, action, resource) when { context has unless };", true],
    ["permit (principal, action, resource) when { context has forbid };", true],
    ["permit (principal, action, resource) when { context.a.has };", false],
    ["permit (principal, action, resource) when { context[\"has\"] };", true],
    ["permit (principal, action, resource) when { {has: 1} };", false],
    ["permit (principal, action, resource) when { {principal: 1} };", true],
    ["permit (principal, action, resource) when { {context: 1}.context };", true],
    ["permit (principal, action, resource) when { {\"if\": 1}[\"if\"] };", true],
    ["permit (principal, action, resource) when { context.a is_ };", false]
  ], fn(c): _conf_parses(c[0]) != c[1];), fn(c): c[0];)
  | assert_eq(failures, [])
end

# Policy texts and the Cedar CLI's JSON policy for them (`has` paths expanded, as cedar_parse does).
def test_conformance_parse_ast():
  let failures = map(filter([
    ["permit (principal, action, resource);", {"effect": "permit", "principal": {"op": "All"}, "action": {"op": "All"}, "resource": {"op": "All"}, "conditions": [], "annotations": {}}],
    ["permit (principal, action, resource) ;", {"effect": "permit", "principal": {"op": "All"}, "action": {"op": "All"}, "resource": {"op": "All"}, "conditions": [], "annotations": {}}],
    ["permit(principal,action,resource);", {"effect": "permit", "principal": {"op": "All"}, "action": {"op": "All"}, "resource": {"op": "All"}, "conditions": [], "annotations": {}}],
    ["forbid (principal, action, resource);", {"effect": "forbid", "principal": {"op": "All"}, "action": {"op": "All"}, "resource": {"op": "All"}, "conditions": [], "annotations": {}}],
    ["permit (principal, action, resource,);", {"effect": "permit", "principal": {"op": "All"}, "action": {"op": "All"}, "resource": {"op": "All"}, "conditions": [], "annotations": {}}],
    ["permit (principal, action, resource) when { true };", {"effect": "permit", "principal": {"op": "All"}, "action": {"op": "All"}, "resource": {"op": "All"}, "conditions": [{"kind": "when", "body": {"Value": true}}], "annotations": {}}],
    ["permit (principal, action, resource) when { true } unless { false };", {"effect": "permit", "principal": {"op": "All"}, "action": {"op": "All"}, "resource": {"op": "All"}, "conditions": [{"kind": "when", "body": {"Value": true}}, {"kind": "unless", "body": {"Value": false}}], "annotations": {}}],
    ["permit (principal, action, resource) unless { false } when { true };", {"effect": "permit", "principal": {"op": "All"}, "action": {"op": "All"}, "resource": {"op": "All"}, "conditions": [{"kind": "unless", "body": {"Value": false}}, {"kind": "when", "body": {"Value": true}}], "annotations": {}}],
    ["permit (principal, action, resource) when { true } when { true };", {"effect": "permit", "principal": {"op": "All"}, "action": {"op": "All"}, "resource": {"op": "All"}, "conditions": [{"kind": "when", "body": {"Value": true}}, {"kind": "when", "body": {"Value": true}}], "annotations": {}}],
    ["@id(\"a\") permit (principal, action, resource);", {"effect": "permit", "principal": {"op": "All"}, "action": {"op": "All"}, "resource": {"op": "All"}, "conditions": [], "annotations": {"id": "a"}}],
    ["@id permit (principal, action, resource);", {"effect": "permit", "principal": {"op": "All"}, "action": {"op": "All"}, "resource": {"op": "All"}, "conditions": [], "annotations": {"id": None}}],
    ["@id(\"a\") @doc(\"b\") permit (principal, action, resource);", {"effect": "permit", "principal": {"op": "All"}, "action": {"op": "All"}, "resource": {"op": "All"}, "conditions": [], "annotations": {"doc": "b", "id": "a"}}],
    ["@a1_b(\"x\") permit (principal, action, resource);", {"effect": "permit", "principal": {"op": "All"}, "action": {"op": "All"}, "resource": {"op": "All"}, "conditions": [], "annotations": {"a1_b": "x"}}],
    ["@if(\"x\") permit (principal, action, resource);", {"effect": "permit", "principal": {"op": "All"}, "action": {"op": "All"}, "resource": {"op": "All"}, "conditions": [], "annotations": {"if": "x"}}],
    ["@permit(\"x\") permit (principal, action, resource);", {"effect": "permit", "principal": {"op": "All"}, "action": {"op": "All"}, "resource": {"op": "All"}, "conditions": [], "annotations": {"permit": "x"}}],
    ["@id(\"a\")\n@doc(\"b\")\npermit (principal, action, resource);", {"effect": "permit", "principal": {"op": "All"}, "action": {"op": "All"}, "resource": {"op": "All"}, "conditions": [], "annotations": {"doc": "b", "id": "a"}}],
    ["@ id(\"a\") permit (principal, action, resource);", {"effect": "permit", "principal": {"op": "All"}, "action": {"op": "All"}, "resource": {"op": "All"}, "conditions": [], "annotations": {"id": "a"}}],
    ["@id (\"a\") permit (principal, action, resource);", {"effect": "permit", "principal": {"op": "All"}, "action": {"op": "All"}, "resource": {"op": "All"}, "conditions": [], "annotations": {"id": "a"}}],
    ["@id(\"\") permit (principal, action, resource);", {"effect": "permit", "principal": {"op": "All"}, "action": {"op": "All"}, "resource": {"op": "All"}, "conditions": [], "annotations": {"id": ""}}],
    ["permit (principal == User::\"a\", action, resource);", {"effect": "permit", "principal": {"op": "==", "entity": {"type": "User", "id": "a"}}, "action": {"op": "All"}, "resource": {"op": "All"}, "conditions": [], "annotations": {}}],
