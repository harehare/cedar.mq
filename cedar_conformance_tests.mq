    ["ip(\"1.2.3.4/32\")", "ip(\"1.2.3.4/32\")"],
    ["ip(\"1.2.3.4/33\")", "ERR"],
    ["ip(\"1.2.3.4/\")", "ERR"],
    ["ip(\"1.2.3.4/-1\")", "ERR"],
    ["ip(\"1.2.3.4/+8\")", "ERR"],
    ["ip(\"1.2.3.4/08\")", "ERR"],
    ["ip(\"1.2.3.4/8/8\")", "ERR"],
    ["ip(\"/8\")", "ERR"],
    ["ip(\"::\")", "ip(\"::\")"],
    ["ip(\"::1\")", "ip(\"::1\")"],
    ["ip(\"::1/128\")", "ip(\"::1/128\")"],
    ["ip(\"::1/129\")", "ERR"],
    ["ip(\"1::\")", "ip(\"1::\")"],
    ["ip(\"1::2\")", "ip(\"1::2\")"],
    ["ip(\"1:2:3:4:5:6:7:8\")", "ip(\"1:2:3:4:5:6:7:8\")"],
    ["ip(\"1:2:3:4:5:6:7::\")", "ip(\"1:2:3:4:5:6:7::\")"],
    ["ip(\"::2:3:4:5:6:7:8\")", "ip(\"::2:3:4:5:6:7:8\")"],
