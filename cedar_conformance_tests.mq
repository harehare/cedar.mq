    ["permit (principal is Group, action == Action::\"edit\", resource == Photo::\"ghost\");\nforbid (principal in Group::\"all\", action in Action::\"read\", resource in Album::\"trip\") unless { context.who in Group::\"staff\" };", {"principal": "User::\"ghost\"", "action": "Action::\"edit\"", "resource": "Album::\"trip\"", "context": {"mfa": true, "n": 3, "neg": -3, "name": "report.pdf", "empty": "", "none": [], "nested": {"a": {"b": 1}}, "unicode": "日本語", "dec": {"__extn": {"fn": "decimal", "arg": "1.5"}}, "at": {"__extn": {"fn": "datetime", "arg": "2024-10-15T11:35:00.123Z"}}, "dur": {"__extn": {"fn": "duration", "arg": "2h"}}, "who": {"__entity": {"type": "User", "id": "bob"}}}}, {"decision": "deny", "reasons": [], "errors": []}],
